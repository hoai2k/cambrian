{
  "name": "cambrian-explosion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "node tools/check-creature-assets.mjs",
    "palettes": "node tools/palette-test.mjs",
    "bindings": "esbuild tools/menu-bindings-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/menu-bindings.mjs && node node_modules/.cache/menu-bindings.mjs",
    "cards": "node tools/make-cards.mjs",
    "lods": "node tools/make-lods.mjs",
    "portraits": "node tools/portrait-test.mjs",
    "layout": "node tools/select-layout.mjs",
    "feast": "esbuild tools/feast-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/feast-test.mjs && node node_modules/.cache/feast-test.mjs",
    "paddle": "esbuild tools/paddle-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/paddle-test.mjs && node node_modules/.cache/paddle-test.mjs",
    "swim": "esbuild tools/swim-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/swim-test.mjs && node node_modules/.cache/swim-test.mjs",
    "world": "esbuild tools/world-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/world-test.mjs && node node_modules/.cache/world-test.mjs",
    "motion": "esbuild tools/motion-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/motion-test.mjs && node node_modules/.cache/motion-test.mjs",
    "hiding": "esbuild tools/hiding-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hiding-test.mjs && node node_modules/.cache/hiding-test.mjs",
    "progress": "esbuild tools/progress-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/progress-test.mjs && node node_modules/.cache/progress-test.mjs cambrian && node node_modules/.cache/progress-test.mjs devonian",
    "codex": "esbuild tools/codex-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/codex-test.mjs && node node_modules/.cache/codex-test.mjs cambrian && node node_modules/.cache/codex-test.mjs devonian",
    "debug": "esbuild tools/debug-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/debug-test.mjs && node node_modules/.cache/debug-test.mjs",
    "eras": "node tools/era-test.mjs",
    "merge": "node --experimental-transform-types tools/merge-test.mjs",
    "shapes": "node tools/prop-shapes.mjs",
    "props": "esbuild tools/prop-collider-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/prop-collider-test.mjs --log-level=error && node node_modules/.cache/prop-collider-test.mjs",
    "devonian": "esbuild tools/devonian-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/devonian-test.mjs && node node_modules/.cache/devonian-test.mjs",
    "devonian:catalogue": "node tools/devonian/catalogue.mjs",
    "devonian:plates": "node tools/devonian/biome-plates.mjs",
    "devonian:stats": "node tools/devonian/stats.mjs",
    "devonian:check": "node tools/devonian/check.mjs --shipped && node tools/devonian/check-props.mjs --shipped && node tools/devonian/catalogue.mjs --check",
    "devonian:check-all": "node tools/devonian/check.mjs && node tools/devonian/check-props.mjs && node tools/devonian/catalogue.mjs --check",
    "menus": "esbuild tools/menu-cursor-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/menu-cursor.mjs && node node_modules/.cache/menu-cursor.mjs",
    "swap": "esbuild tools/swap-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/swap.mjs && node node_modules/.cache/swap.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.0",
    "meshoptimizer": "^0.22.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.1.0"
  }
}
